# Copy to .env locally and replace the placeholder with a unique random value.
# Optional examples/node-connector configuration, not an Open Giving service.
# SDK tests need none of these values. No donor registration or database needed.
# Never commit .env. The example never prints this credential.
OPEN_GIVING_SERVICE_TOKEN=replace-with-a-random-service-token-at-least-32-characters
OPEN_GIVING_MODE=demo
PORT=3001
OPEN_GIVING_PUBLIC_ORIGIN=http://127.0.0.1:3001
